# Backend environment variables
# Copy to .env for local development (never commit .env)

PORT=4000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/tours_booking?appName=Cluster0
JWT_SECRET_KEY=replace_with_a_long_random_secret

# Comma-separated frontend origins allowed by CORS
# Local example:
CLIENT_URL=http://localhost:3000,http://127.0.0.1:3000

# Production example (set in Vercel Backend project → Settings → Environment Variables):
# CLIENT_URL=https://your-frontend.vercel.app
